\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{roboto}[2026/04/22 Local fallback for resume builds]

\RequirePackage{fontspec}

\newfontfamily\roboto[
  Path = fonts/,
  Extension = .ttf,
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-Italic,
  BoldItalicFont = *-BoldItalic
]{Roboto}

\newfontfamily\robotolight[
  Path = fonts/,
  Extension = .ttf,
  UprightFont = *-Light,
  ItalicFont = *-LightItalic
]{Roboto}